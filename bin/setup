#!/bin/sh
set -eu
READING_ROOM_CHECKOUT=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd)
# Prefer the newest supported interpreter on PATH. Keep this list in sync with
# MIN_PYTHON/MAX_PYTHON in src/book_library/install_defaults.py.
for candidate in python3.15 python3.14 python3.13 python3.12; do
  if command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" "$READING_ROOM_CHECKOUT/scripts/setup.py" "$@"
  fi
done
echo 'Python 3.12–3.15 is required. Install it from https://www.python.org/downloads/macos/ or your package manager, then run ./bin/setup again.' >&2
exit 1
